# Copy this file to scripts/signing.env and replace every placeholder.
# scripts/signing.env is git-ignored and must never contain committed secrets.

# Exact certificate name from:
#   security find-identity -v -p codesigning
SIGNING_IDENTITY='Developer ID Application: Your Name (TEAMID1234)'

# The ten-character Team ID printed by the certificate.
TEAM_ID='TEAMID1234'

# Name of the notarytool keychain profile created with:
#   xcrun notarytool store-credentials tapthatx-notary
NOTARY_PROFILE='tapthatx-notary'
